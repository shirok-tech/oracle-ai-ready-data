-- Generated by generate_semantics_collector.py. Do not run this template directly.
-- Read-only: dictionary SELECT statements only; no provider calls or object changes.
-- Run with @collect_ai_semantics.sql in an already connected SQLcl session.
-- Scope: current-session-visible ordinary tables and their non-hidden columns.
-- Sources:
-- https://docs.oracle.com/en/database/oracle/oracle-database/26/refrn/ALL_ANNOTATIONS_USAGE.html
-- https://docs.oracle.com/en/database/oracle/oracle-database/26/refrn/ALL_TAB_COLUMNS.html
set define off
set echo off
-- Normalize SQLcl settings before spooling so existing session preferences
-- cannot alter the JSON, automatically commit, or write error-log rows.
set encoding UTF-8
set timing off
set autotrace off
set autocommit off
set errorlogging off
set sqlblanklines on
set tab off
set verify off
set feedback off
set heading off
set pagesize 0
set linesize 32767
set trimspool on
set termout off
set sqlformat default
set serveroutput on size unlimited format wrapped
-- Keep any pre-existing transaction untouched; malformed/incomplete JSON is rejected.
whenever oserror continue none
whenever sqlerror continue none
spool __SPOOL_FILE__ create

declare
  c_owner constant varchar2(128) := __OWNER__;
  c_table_like constant varchar2(256) := __TABLE_LIKE__;
  v_first_record boolean := true;
  v_state varchar2(40);
  v_diagnostic varchar2(4000);
  v_code number;
  v_ok boolean;

  function json_value(p_value varchar2) return varchar2 is
    v_value varchar2(32767);
  begin
    if p_value is null then return 'null'; end if;
    v_value := replace(replace(p_value, '\', '\\'), '"', '\"');
    for i in 0..31 loop
      v_value := replace(v_value, chr(i), '\u' || lpad(to_char(i, 'FMXX'), 4, '0'));
    end loop;
    -- Each source field is at most 4000 bytes. Escaping expands at most sixfold.
    -- One field per output line avoids DBMS_OUTPUT's 32767-byte line limit.
    if lengthb(v_value) > 32000 then
      raise_application_error(-20001, 'Metadata field exceeds safe JSON output size');
    end if;
    return '"' || v_value || '"';
  end;

  procedure start_record(p_type varchar2) is
  begin
    if not v_first_record then dbms_output.put_line(','); end if;
    v_first_record := false;
    dbms_output.put_line('{');
    dbms_output.put_line('"type":' || json_value(p_type));
  end;

  procedure field(p_name varchar2, p_value varchar2) is
  begin
    dbms_output.put_line(',' || json_value(p_name) || ':' || json_value(p_value));
  end;

  procedure status_record(p_component varchar2, p_state varchar2, p_diagnostic varchar2) is
  begin
    start_record('status');
    field('component', p_component);
    field('state', p_state);
    field('diagnostic', p_diagnostic);
    dbms_output.put_line('}');
  end;

  function failure_state(p_code number) return varchar2 is
  begin
    if p_code = -1031 then return 'permission_denied'; end if;
    -- Missing/invisible dictionary views cannot distinguish unsupported from hidden.
    if p_code = -942 then return 'unavailable'; end if;
    return 'error';
  end;

  procedure capability(p_view varchar2, p_columns varchar2,
                       p_state out varchar2, p_diagnostic out varchar2) is
    v_cursor integer;
    v_result integer;
    v_visible boolean := false;
  begin
    p_state := 'collected';
    p_diagnostic := null;
    -- Both identifiers below are hardcoded in this reviewed template, never input.
    execute immediate 'select count(*) from ' || p_view || ' where 1 = 0' into v_result;
    v_visible := true;
    v_cursor := dbms_sql.open_cursor;
    dbms_sql.parse(v_cursor, 'select ' || p_columns || ' from ' || p_view || ' where 1 = 0', dbms_sql.native);
    -- Parse validates the required columns; no result fetch/definition is needed.
    dbms_sql.close_cursor(v_cursor);
  exception
    when others then
      p_diagnostic := p_view || ': ' || sqlerrm;
      if v_visible and sqlcode = -904 then
        p_state := 'unsupported';
        p_diagnostic := p_diagnostic || ' (view accessible; required dictionary column unavailable)';
      else
        p_state := failure_state(sqlcode);
      end if;
      if v_cursor is not null and dbms_sql.is_open(v_cursor) then
        dbms_sql.close_cursor(v_cursor);
      end if;
  end;

  procedure query_records(p_type varchar2, p_query varchar2,
                          p_ok out boolean, p_code out number, p_diagnostic out varchar2) is
    v_cursor integer;
    v_result integer;
    v_columns integer;
    v_description dbms_sql.desc_tab2;
    v_value varchar2(32767);
    type value_array is table of varchar2(32767) index by binary_integer;
    v_values value_array;
  begin
    p_ok := false;
    p_code := null;
    p_diagnostic := null;
    v_cursor := dbms_sql.open_cursor;
    dbms_sql.parse(v_cursor, p_query, dbms_sql.native);
    dbms_sql.bind_variable(v_cursor, ':target_owner', c_owner);
    dbms_sql.bind_variable(v_cursor, ':table_like', c_table_like);
    dbms_sql.describe_columns2(v_cursor, v_columns, v_description);
    for i in 1..v_columns loop
      dbms_sql.define_column(v_cursor, i, v_value, 32767);
    end loop;
    v_result := dbms_sql.execute(v_cursor);
    while dbms_sql.fetch_rows(v_cursor) > 0 loop
      -- Validate/escape the complete row before emitting its opening brace.
      for i in 1..v_columns loop
        dbms_sql.column_value(v_cursor, i, v_value);
        v_values(i) := json_value(v_value);
      end loop;
      start_record(p_type);
      for i in 1..v_columns loop
        dbms_output.put_line(',' || json_value(lower(v_description(i).col_name)) || ':' || v_values(i));
      end loop;
      dbms_output.put_line('}');
    end loop;
    dbms_sql.close_cursor(v_cursor);
    p_ok := true;
  exception
    when others then
      p_code := sqlcode;
      p_diagnostic := sqlerrm;
      if v_cursor is not null and dbms_sql.is_open(v_cursor) then
        dbms_sql.close_cursor(v_cursor);
      end if;
  end;
begin
  dbms_output.put_line('{"format":"oracle-ai-semantics-v1","records":[');
  start_record('context');
  field('session_user', sys_context('USERENV', 'SESSION_USER'));
  field('current_schema', sys_context('USERENV', 'CURRENT_SCHEMA'));
  field('target_owner', c_owner);
  field('table_like_pattern', c_table_like);
  field('db_name', sys_context('USERENV', 'DB_NAME'));
  field('con_name', sys_context('USERENV', 'CON_NAME'));
  field('collected_at', to_char(systimestamp, 'YYYY-MM-DD"T"HH24:MI:SS.FF TZH:TZM'));
  field('visibility', 'ALL_* dictionary rows visible to this session; not a database-wide inventory');
  field('object_scope', 'Ordinary tables only; excludes temporary, nested, secondary tables and hidden columns');
  field('origin_basis', 'TABLE annotations: DOMAIN_OWNER/DOMAIN_NAME identify domain inheritance; views and advanced inheritance are not assessed');
  dbms_output.put_line('}');

  query_records('table', q'~
    select t.owner, t.table_name from all_tables t
    where t.owner = :target_owner and t.table_name like :table_like escape '\'
      and nvl(t.temporary, 'N') = 'N' and nvl(t.nested, 'NO') = 'NO' and nvl(t.secondary, 'N') = 'N'
    order by t.owner, t.table_name
  ~', v_ok, v_code, v_diagnostic);
  if v_ok then
    query_records('column', q'~
      select c.owner, c.table_name, c.column_name from all_tab_columns c
      join all_tables t on t.owner = c.owner and t.table_name = c.table_name
      where t.owner = :target_owner and t.table_name like :table_like escape '\'
        and nvl(t.temporary, 'N') = 'N' and nvl(t.nested, 'NO') = 'NO' and nvl(t.secondary, 'N') = 'N'
      order by c.owner, c.table_name, c.column_id
    ~', v_ok, v_code, v_diagnostic);
  end if;
  if v_ok then status_record('scope', 'collected', 'Scope inventory completed, including an empty visible range');
  else status_record('scope', failure_state(v_code), v_diagnostic); end if;

  capability('ALL_ANNOTATIONS_USAGE',
    'ANNOTATION_OWNER, OBJECT_NAME, OBJECT_TYPE, COLUMN_NAME, ANNOTATION_NAME, ANNOTATION_VALUE, DOMAIN_OWNER, DOMAIN_NAME',
    v_state, v_diagnostic);
  if v_state = 'collected' then
    query_records('annotation', q'~
      select t.owner, a.annotation_owner, a.object_name, a.object_type, a.column_name,
             a.annotation_name, a.annotation_value, a.domain_owner, a.domain_name,
             case when a.domain_owner is not null and a.domain_name is not null then 'DOMAIN_INHERITED'
                  when a.domain_owner is null and a.domain_name is null then 'DIRECT'
                  else 'UNKNOWN' end as origin
      from all_annotations_usage a
      join all_tables t on t.owner = a.annotation_owner and t.table_name = a.object_name
      where t.owner = :target_owner and t.table_name like :table_like escape '\'
        and a.object_type = 'TABLE'
        and nvl(t.temporary, 'N') = 'N' and nvl(t.nested, 'NO') = 'NO' and nvl(t.secondary, 'N') = 'N'
        and (a.column_name is null or exists (
          select 1 from all_tab_columns c
          where c.owner = t.owner and c.table_name = t.table_name and c.column_name = a.column_name))
      order by t.owner, a.object_name, a.column_name, a.annotation_name, a.domain_owner, a.domain_name
    ~', v_ok, v_code, v_diagnostic);
    if not v_ok then v_state := failure_state(v_code); end if;
  end if;
  status_record('annotations', v_state, v_diagnostic);

  capability('ALL_TAB_COLUMNS', 'OWNER, TABLE_NAME, COLUMN_NAME, DOMAIN_OWNER, DOMAIN_NAME, DOMAIN_COLUMN_NAME',
    v_state, v_diagnostic);
  if v_state = 'collected' then
    query_records('domain', q'~
      select c.owner, c.table_name, c.column_name, c.domain_owner, c.domain_name, c.domain_column_name
      from all_tab_columns c
      join all_tables t on t.owner = c.owner and t.table_name = c.table_name
      where t.owner = :target_owner and t.table_name like :table_like escape '\'
        and nvl(t.temporary, 'N') = 'N' and nvl(t.nested, 'NO') = 'NO' and nvl(t.secondary, 'N') = 'N'
        and (c.domain_owner is not null or c.domain_name is not null)
      order by c.owner, c.table_name, c.column_name
    ~', v_ok, v_code, v_diagnostic);
    if not v_ok then v_state := failure_state(v_code); end if;
  end if;
  status_record('domains', v_state, v_diagnostic);
  dbms_output.put_line(']}');
end;
/
spool off
set termout on
-- SQLcl session remains connected. Review the JSON before passing --semantics-input.
